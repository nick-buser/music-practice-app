# Frontend build/runtime config. Copy to .env for local dev.
#
# PUBLIC build (Cloudflare Pages): leave VITE_API_BASE_URL unset. The app runs
# entirely on bundled static data — no backend, no auth, no persistence.
#
# LOCAL build (full features): point it at your running backend's origin.
# VITE_API_BASE_URL=http://localhost:8000
