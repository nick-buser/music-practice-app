# syntax=docker/dockerfile:1
#
# Build context is `app/` itself (see .woodpecker/docker.yml), so every COPY
# path below is relative to app/, not the repo root.

# ─── Build stage: install deps, build the SPA with Vite ────────────────
FROM node:22 AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Vite inlines import.meta.env.* at build time, so the API base URL must be
# supplied here rather than at container runtime. Defaults to same-origin
# `/api`, matching the k3s deploy (nginx or an ingress fronts both images).
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# ─── Runtime stage: static SPA served by nginx ──────────────────────────
FROM nginx:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
