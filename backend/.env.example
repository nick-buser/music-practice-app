# Copy to .env for local dev (uv run uvicorn ...). Compose sets these itself.
ENV=dev
# Homelab Postgres (psycopg 3 driver). Leave unset to use in-memory SQLite.
DATABASE_URL=postgresql+psycopg://soundings:soundings@localhost:5432/soundings
CORS_ORIGINS=http://localhost:5173
# Point at your SigNoz OTLP/HTTP collector to enable tracing (optional).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Garage (S3-compatible) object storage for media. Leave unset to fall back to
# the in-memory MediaStore (see app/deps.py) — this laptop can't reach Garage
# at all, so local dev/test runs with these commented out.
# S3_ENDPOINT=http://192.168.1.12:3900
# S3_REGION=us-east-1
# S3_BUCKET=soundings-dev
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
